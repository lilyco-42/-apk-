<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surfaceBackground" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_workspace" android:textColor="@color/colorPrimary" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/app_name"
            android:textColor="@color/textPrimary" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/home_intro_detail"
            android:textColor="@color/textSecondary" android:textSize="14sp" />
        <TextView android:id="@+id/tv_account_bar" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:padding="12dp" android:text="未登录 · 点击登录"
            android:background="@drawable/bg_cyber_card" android:clickable="true"
            android:focusable="true" android:foreground="?attr/selectableItemBackground"
            android:textColor="@color/colorPrimary" android:textSize="14sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/card_mock_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:orientation="vertical" android:padding="18dp" android:minHeight="48dp"
            android:background="@drawable/bg_status_warn" android:clickable="true"
            android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <TextView android:id="@+id/tv_mock_status_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/home_mock_off_title"
                android:textColor="@color/saberGold" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_mock_status_detail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/home_mock_off_detail" android:textColor="@color/textSecondary" android:textSize="13sp" />
            <TextView android:id="@+id/tv_mock_status_action" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/home_mock_action" android:textColor="@color/saberGold" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:layout_marginBottom="12dp" android:text="@string/home_intro"
            android:textColor="@color/textPrimary" android:textSize="18sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/card_route_create" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="20dp"
            android:orientation="vertical" android:background="@drawable/bg_route_primary"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/home_step_create" android:textColor="@color/colorPrimary" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/home_create_action" android:textColor="@color/textPrimary"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/home_create_detail" android:textColor="@color/textSecondary" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/card_route_run" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="20dp"
            android:orientation="vertical" android:background="@drawable/bg_cyber_card"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/home_step_run" android:textColor="@color/colorPrimary" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/home_route_run" android:textColor="@color/textPrimary"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/home_run_detail" android:textColor="@color/textSecondary" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/card_route_library" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="20dp"
            android:orientation="vertical" android:background="@drawable/bg_cyber_card"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/home_step_manage" android:textColor="@color/colorPrimary" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/home_route_library" android:textColor="@color/textPrimary"
                android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="@string/home_library_detail" android:textColor="@color/textSecondary" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/card_route_market" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:padding="20dp"
            android:orientation="vertical" android:background="@drawable/bg_cyber_card"
            android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="社区" android:textColor="@color/saberGold" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="路线社区"
                android:textColor="@color/textPrimary" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="别人上传的打卡路线，用积分购买；也可以上传自己的路线赚积分。"
                android:textColor="@color/textSecondary" android:textSize="14sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/home_tools"
            android:textColor="@color/textSecondary" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_settings"
            style="@style/SaberGhostButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/app_settings" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_check_update"
            style="@style/SaberGhostButton" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/home_update_title" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
